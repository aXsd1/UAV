diff --git a/src/lib/weather_vane/WeatherVane.cpp b/src/lib/weather_vane/WeatherVane.cpp
index 384d55d874..248250623c 100644
--- a/src/lib/weather_vane/WeatherVane.cpp
+++ b/src/lib/weather_vane/WeatherVane.cpp
@@ -79,6 +79,14 @@ float WeatherVane::getWeathervaneYawrate()
 
 	float roll_sp = -asinf(body_z_sp(1));
 
+	if (_param_wv_axis.get() == 1) {
+		// Side-on: drive the forward/backward lean to zero instead, so the wind ends up on the
+		// body y axis. The sign of the roll lean picks the nearer side, so the vehicle turns
+		// at most 90 deg. For tailsitters this puts the wing edge-on to the wind in hover.
+		const float side = (roll_sp >= 0.f) ? 1.f : -1.f;
+		roll_sp = side * asinf(body_z_sp(0));
+	}
+
 	float roll_exceeding_treshold = 0.0f;
 	float min_roll_rad = math::radians(_param_wv_roll_min.get());
 
