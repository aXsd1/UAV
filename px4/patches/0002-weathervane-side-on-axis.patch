diff --git a/src/lib/weather_vane/weathervane_params.c b/src/lib/weather_vane/weathervane_params.c
index 9cf6e021c1..1d487d19f4 100644
--- a/src/lib/weather_vane/weathervane_params.c
+++ b/src/lib/weather_vane/weathervane_params.c
@@ -80,3 +80,15 @@ PARAM_DEFINE_FLOAT(WV_ROLL_MIN, 1.0f);
  * @group Multicopter Position Control
  */
 PARAM_DEFINE_FLOAT(WV_YRATE_MAX, 90.0f);
+
+/**
+ * Weathervane axis
+ *
+ * Which body axis is turned into the wind. Side-on is meant for tailsitters, whose
+ * wing is edge-on to the wind with this setting, reducing drag and lean in hover.
+ *
+ * @value 0 Heading (body x) into the wind
+ * @value 1 Side-on (body y) into the wind
+ * @group Multicopter Position Control
+ */
+PARAM_DEFINE_INT32(WV_AXIS, 0);
